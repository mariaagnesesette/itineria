        zv1_0.ciclabile,
        zv1_0.dog_friendly,
        zv1_0.ristoro,
        zv1_0.tipologia 
    from
        zone_verdi zv1_0 
    join
        luoghi_interesse zv1_1 
            on zv1_0.id=zv1_1.id 
    where
        zv1_1.sempre_aperto=? 
    limit
        ?, ?
