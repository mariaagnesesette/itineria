        zv1_1.created_at,
        zv1_1.descrizione,
        zv1_1.email,
        zv1_1.indirizzo,
        zv1_1.link_sito,
        zv1_1.id_manager,
        zv1_1.nome,
        zv1_1.numero_telefono,
        zv1_1.sempre_aperto,
